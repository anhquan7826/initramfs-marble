#!/bin/busybox ash
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

echo "[marble-init] start" > /dev/console 2>/dev/null

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /run /sysroot
mount -t devpts devpts /dev/pts
mount -t tmpfs run /run

root_uuid=
root_dev=
root_type=ext4
root_opts=
debug=

for arg in $(cat /proc/cmdline); do
  case "$arg" in
    root=*) root_dev=${arg#*=} ;;
    rootfstype=*) root_type=${arg#*=} ;;
    marble.debug=*) debug=${arg#*=} ;;
  esac
done

case "$root_dev" in
  UUID=*) root_uuid=${root_dev#UUID=} root_dev= ;;
  /dev/*) ;;
  *) root_dev= ;;
esac

if [ -f /modules.list ]; then
  while read -r mod; do
    case "$mod" in
      ''|\#*) continue ;;
    esac
    modprobe "$mod" 2>/dev/null || true
  done < /modules.list
fi
echo "[marble-init] modules loaded" > /dev/console 2>/dev/null

for hook in /hooks/*; do
  [ -x "$hook" ] && "$hook"
done

if [ -z "$root_dev" ] && [ -n "$root_uuid" ]; then
  count=0
  while [ "$count" -lt 30 ]; do
    for dev in /dev/sd* /dev/mmcblk*p* /dev/block/sd* /dev/block/mmcblk*p*; do
      [ -b "$dev" ] || continue
      info=$(blkid "$dev" 2>/dev/null) || continue
      case "$info" in
        *"UUID=\"$root_uuid\""*) root_dev=$dev; break ;;
      esac
    done
    [ -n "$root_dev" ] && break
    sleep 1
    count=$((count + 1))
  done
fi

if [ -z "$root_dev" ]; then
  echo "[marble-init] no root device found - dropping to shell" > /dev/console 2>/dev/null
  exec /bin/busybox ash
fi

info=$(blkid "$root_dev" 2>/dev/null) || info=
case "$info" in
  *' TYPE="'*)
    detected=${info#* TYPE=\"}
    detected=${detected%%\"*}
    [ -n "$detected" ] && root_type=$detected
    ;;
esac
root_opts=${root_opts#,}
echo "[marble-init] root=$root_dev type=$root_type" > /dev/console 2>/dev/null
if [ -n "$root_opts" ]; then
  mount -t "$root_type" -o "rw,$root_opts" "$root_dev" /sysroot
else
  mount -t "$root_type" -o rw "$root_dev" /sysroot
fi

INIT=/sbin/init
for candidate in /sbin/init /usr/sbin/init /lib/systemd/systemd /usr/lib/systemd/systemd; do
  if [ -x "/sysroot$candidate" ]; then
    INIT=$candidate
    break
  fi
done

if [ ! -x "/sysroot$INIT" ]; then
  echo "[marble-init] init binary missing on rootfs - dropping to shell" > /dev/console 2>/dev/null
  exec /bin/busybox ash
fi

echo "[marble-init] switching to $INIT in 10 seconds" > /dev/console 2>/dev/null
sleep 10
killall telnetd 2>/dev/null || true
exec switch_root /sysroot "$INIT"
